# Since the ".env.local" file is gitignored, you can use the ".env.example"
# file to build a new ".env.local" file when you clone the repo. Keep this
# file up-to-date when you add new variables to `.env.local`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Prisma (Neon)
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Pooled URL for app runtime; Prisma CLI loads this from .env.local via prisma.config.ts
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
# Direct URL for migrations / pg_dump (optional)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# Optional override for the server-side hello cURL target (defaults to
# https://$VERCEL_URL/api/hello in production, http://127.0.0.1:3000/api/hello locally)
HELLO_BACKEND_URL=

# Neon
# https://neon.tech/docs/connection-urls#env
NEON_BRANCH=
NEON_FUNCTION_API_BASE_URL=

# ---------------------------------------------------------------------------
# Vercel (Project Settings → Environment Variables)
# ---------------------------------------------------------------------------
# Paste the same values as .env.local. Vercel has no .env.local file; Next.js
# and Prisma read process.env. prisma.config.ts skips file loading when
# .env.local is absent, so the Neon DATABASE_URL from Vercel is used as-is.
#
# Required:
#   AUTH_SECRET
#   DATABASE_URL          <- Neon pooled URL (-pooler host, sslmode=require)
#
# Optional (only if you use Discord login / run migrations from CI):
#   AUTH_DISCORD_ID
#   AUTH_DISCORD_SECRET
#   DATABASE_URL_UNPOOLED <- Neon direct URL (not the -pooler host)
#
# Do not commit real secrets here. Copy values from .env.local into the
# Vercel dashboard; leave Environment = Production (and Preview if needed).