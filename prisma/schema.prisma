generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Vehicle {
    id       String @id @default(cuid())
    label    String
    tankSize Float

    readings FuelReading[]
    alerts   Alert[]
}

model FuelReading {
    id        String  @id @default(cuid())
    vehicleId String
    vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

    timestamp DateTime
    level     Float
    speed     Float?
    accel     Float?

    @@index([vehicleId, timestamp])
}

model Alert {
    id        String    @id @default(cuid())
    vehicleId String
    vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

    type       AlertType
    confidence Float
    reason     String
    dropAmount Float
    createdAt  DateTime  @default(now())

    @@index([vehicleId, createdAt])
}

enum AlertType {
    POTHOLE_OR_SLOSH
    LEAK
    THEFT
    UNKNOWN
}